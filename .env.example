# Microsoft Entra ID OIDC (Auth.js). Configure only in local/deployment secret stores.
# Register the callback URL: http://localhost:3000/api/auth/callback/microsoft-entra-id
AUTH_SECRET=
# Set true only when the app is behind a trusted host/proxy configuration.
AUTH_TRUST_HOST=false
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# Required issuer from the Entra tenant's OpenID Connect metadata document.
# Obtain the exact issuer from the organization; no tenant or issuer is assumed here.
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# Supabase (current POC datastore). Values are provided by the project owner.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional Lin enhancement. Lin remains unavailable while this value is unset.
GEMINI_API_KEY=
# Enable external Gemini calls only after the organization approves that use.
LIN_EXTERNAL_AI_ENABLED=false
