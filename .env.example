# Auth.js session signing/encryption secret. Separate from the Entra app secret.
AUTH_SESSION_SECRET=
AUTH_TRUST_HOST=true

# Microsoft Entra ID OIDC. Configure only in local/deployment secret stores.
# Register the callback URL: http://localhost:3000/api/auth/callback/microsoft-entra-id
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_ISSUER=

# Supabase PostgreSQL and Storage (application data, metadata, and files).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only database/storage access; never expose this key to the browser.
SUPABASE_SERVICE_ROLE_KEY=
