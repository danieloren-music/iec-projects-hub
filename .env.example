# Generated locally by the app owner; this is not an Entra credential.
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep the same value in local development and the hosting provider's secret store.
AUTH_SECRET=

# Microsoft Entra SAML 2.0. Keep the signing certificate in the local/Vercel
# secret store, not in Git. The Base64 CER body or PEM certificate is accepted.
ENTRA_SAML_BASE_URL=https://iec-projects-hub.vercel.app
ENTRA_SAML_ENTRY_POINT=
ENTRA_SAML_IDP_ISSUER=
ENTRA_SAML_IDP_CERT=

# Optional production local administrator sign-in. In development without
# these values, the temporary admin/admin account is enabled automatically.
# Generate the password hash with: npm run auth:hash-admin
# Store the hash only in an untracked local env file or your hosting secret store.
LOCAL_ADMIN_USERNAME=
LOCAL_ADMIN_PASSWORD_HASH=

# Required for the Supabase database connection.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required for private project files and task reads/writes.
# Server-only secret; never use the service_role key in client-side code.
SUPABASE_SERVICE_ROLE_KEY=

# Optional Lin assistant. Calls Gemini only when explicitly enabled.
# Create a key in Google AI Studio; keep it on the server and never use a NEXT_PUBLIC_ prefix.
GEMINI_API_KEY=
LIN_EXTERNAL_AI_ENABLED=false
