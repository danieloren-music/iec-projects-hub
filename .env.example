# Microsoft Entra ID OIDC (Auth.js). Configure only in local/deployment secret stores.
# Register the callback URL: http://localhost:3000/api/auth/callback/microsoft-entra-id
AUTH_SECRET=
AUTH_TRUST_HOST=true
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# Supabase PostgreSQL and Storage (application data, metadata, and files).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only database/storage access; never expose this key to the browser.
SUPABASE_SERVICE_ROLE_KEY=
